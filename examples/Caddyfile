# Set all environment variables before starting Caddy. No credentials belong here.
# NAIVEFOX_SERVER: the HTTPS hostname (for example proxy.example.com).
# NAIVEFOX_APP_ROOT: absolute path to a validated copy of the application template.
# The :443 catch-all is required because classic CONNECT uses the destination
# authority, not the proxy hostname, in the HTTP request.
:443, {$NAIVEFOX_SERVER} {
	route {
		naivefox_transport {
			application_root {$NAIVEFOX_APP_ROOT}
			forward_proxy {
				basic_auth {$NAIVEFOX_USER} {$NAIVEFOX_PASSWORD}
				hide_ip
				hide_via
				probe_resistance
			}
		}
		respond 404
	}
}
