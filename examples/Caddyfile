# Keep configuration, private keys and logs outside the public directory.
# Set these variables for validate, run and reload:
#   NAIVEFOX_SERVER=proxy.example.com
#   NAIVEFOX_APP_ROOT=/etc/caddy/naivefox-app
#   NAIVEFOX_USER=USER
#   NAIVEFOX_PASSWORD=PASSWORD
#
# The root contains index.html and its supported directly declared resources.
# Names, resource count and sizes are operator choices. The client does not
# execute scripts. Reload after changing the public snapshot or root directory.
# Configure service variables in the service environment.

{$NAIVEFOX_SERVER} {
	route {
		naivefox_transport {
			application_root {$NAIVEFOX_APP_ROOT}
			basic_auth {$NAIVEFOX_USER} {$NAIVEFOX_PASSWORD}
		}
		respond 404
	}
}
