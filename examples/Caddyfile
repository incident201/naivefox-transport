# Set all environment variables before starting Caddy. No credentials belong here.
# NAIVEFOX_SERVER: the HTTPS hostname (for example proxy.example.com).
{$NAIVEFOX_SERVER} {
	route {
		naivefox_transport {
			forward_proxy {
				basic_auth {$NAIVEFOX_USER} {$NAIVEFOX_PASSWORD}
				hide_ip
				hide_via
				probe_resistance
			}
		}
		respond 404
	}
}
